# Keep credentials in .env only. Never expose keys in frontend variables.
APP_BASE_URL=http://127.0.0.1:3000
PORT=3000
VITE_PORT=5173
CUA_LOCAL_DIR=.local
# Optional >=32 character secret; local setup otherwise creates .local/session-secret.
APP_SESSION_SECRET=
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=cua-parse-evidence-v1
# OpenAI analysis is enabled explicitly; fixture analysis always uses known synthetic labels.
ANALYSIS_MODE=unlabeled
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
RETRIEVAL_MODE=bm25
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
VOICE_MODE=disabled
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2
# Dedicated agent IDs created by npm run setup:voice are saved in .local/voice-agent.json.
DATA_MODE=all
MAX_THREADS=10
MAX_ITEMS=150
COLLECTION_CONCURRENCY=2
JOB_TIMEOUT_MS=180000

# Optional existing Elastic Cloud corpus and Agent Builder (server-side only)
ELASTIC_CLOUD_URL=
ELASTIC_CLOUD_KIBANA_URL=
ELASTIC_CLOUD_API_KEY=
ELASTIC_CLOUD_INDEX=youtube-product-comments
